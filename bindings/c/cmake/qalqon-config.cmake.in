@PACKAGE_INIT@

if(NOT TARGET qalqon::qalqon)
  add_library(qalqon::qalqon STATIC IMPORTED)
  set_target_properties(qalqon::qalqon PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libqalqon.a"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    INTERFACE_LINK_LIBRARIES "pthread;dl;m")
endif()
